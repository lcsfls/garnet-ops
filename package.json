{
  "name": "garnetops",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @garnetops/db generate",
    "scanners:fetch": "node scripts/fetch-scanners.mjs",
    "dev:stop": "node scripts/dev-stop.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "typescript": "^5.9.0"
  }
}
